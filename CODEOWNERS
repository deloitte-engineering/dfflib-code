##############################################################
#
# List of approvers/reviewers for D'fflib project
#
# Syntax: https://docs.github.com/articles/about-code-owners
# Rules are LAST-MATCH-WINS: the final matching pattern for a
# file decides its owners. Keep specific paths BELOW the
# global default so they take precedence.
#
##############################################################
#
# Get in touch with us via the published Community
#  https://github.com/deloitte-engineering/dfflib
#

# Default owners for everything in the repo.
*                                @deloitte-engineering/d-fflib-team @rfernandesdossantos @rvandenassum

# D'fflib framework layer: every force-app sub-folder (source + metadata).
/force-app/                      @deloitte-engineering/d-fflib-team @rfernandesdossantos @rvandenassum

# Submodule pointers: a pointer change or a change to the submodule list needs the owners' review.
/dependencies/                   @deloitte-engineering/d-fflib-team @rfernandesdossantos @rvandenassum

# The submodule list, and the workflows and actions (the allowlist and guards cannot change without the owners).
/.gitmodules                     @deloitte-engineering/d-fflib-team @rfernandesdossantos @rvandenassum
/.github/                        @deloitte-engineering/d-fflib-team @rfernandesdossantos @rvandenassum

# Build scripts, including the assemble script and guards the assemble action runs.
/build/                          @deloitte-engineering/d-fflib-team @rfernandesdossantos @rvandenassum

# Documentation.
*.md                             @deloitte-engineering/d-fflib-team @rfernandesdossantos @rvandenassum
